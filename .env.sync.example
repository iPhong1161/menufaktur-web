# .env.sync — one-time prod → dev anonymized sync
# Copy this file to `.env.sync` and fill in real values. The .env.sync file
# is gitignored via the existing `.env*` rule.
#
# Run:  node --env-file=.env.sync scripts/sync-prod-to-dev.js

# Production Supabase (READ-ONLY — script only ever calls .select())
PROD_SUPABASE_URL=
PROD_SERVICE_ROLE_KEY=

# Dev Supabase (WRITE-ONLY — script only ever calls .insert())
DEV_SUPABASE_URL=
DEV_SERVICE_ROLE_KEY=
